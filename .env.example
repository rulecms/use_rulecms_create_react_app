# RuleCMS Configuration
# Copy this file to .env.local and replace with your actual values

# Your RuleCMS App Token
# Get this from your RuleCMS project settings > API Tokens
REACT_APP_RULECMS_TOKEN=your_app_token_here

# Example widget published key (replace with your actual published key)
# REACT_APP_PUBLISHED_KEY=your_published_key_here